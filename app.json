{
  "expo": {
    "name": "getir-clone",
    "slug": "getir-clone",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./public/assets/images/getir-logo.png",
    "scheme": "getir",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./public/assets/images/getir-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#5D3EBD"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourname.getirclone"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./public/assets/images/getir-logo.png",
        "backgroundColor": "#5D3EBD"
      },
      "package": "com.yourname.getirclone",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./public/assets/app/favicon.png",
      "name": "Getir Clone",
      "shortName": "Getir",
      "lang": "tr",
      "themeColor": "#5D3EBD",
      "backgroundColor": "#F5F5F5",
      "description": "Dakikalar içinde market alışverişi."
    },
    "primaryColor": "#5D3EBD"
  }
}
